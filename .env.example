# ===========================================================================
# AI Video Attendance API - environment template
#
# Copy to `.env` and edit:   cp .env.example .env   (bash)
#                            copy .env.example .env  (PowerShell)
#
# Every key below is OPTIONAL in development (app/config.py defaults apply)
# except where marked REQUIRED IN PRODUCTION.  Never commit a filled-in .env
# (.gitignore covers it); distribute this template instead.
# ===========================================================================

# ------------------------------------------------------------------- app
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_FORMAT=json
CORS_ORIGINS=*
DATA_DIR=./data
# Which calendar day a UTC timestamp belongs to (SRM Haryana = IST).
LOCAL_TIMEZONE=Asia/Kolkata
SEED_VIDEO_PATH=./samples/videos/lecture.mp4

# ---------------------------------------------------------------- database
# Local (no-Docker) default used by scripts/setup_dev.*; docker-compose.yml
# overrides this with the in-network postgres hostname.
DATABASE_URL=sqlite:///./data/attendance.db

# ------------------------------------------------------------------- redis
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------- auth
AUTH_REQUIRED=true
# REQUIRED IN PRODUCTION - a long random string (e.g. openssl rand -hex 32).
# Startup fails when ENVIRONMENT=production and this is left at the default.
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720
# Bootstrap super-admin account - CHANGE before any shared deployment.
# Startup FAILS when ENVIRONMENT=production and this is left at "admin".
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
# Login throttle: attempts per (ip, user) per minute before HTTP 429 (0 = off).
AUTH_RATE_LIMIT_PER_MINUTE=10
# Request bodies above this many bytes are rejected with HTTP 413.
MAX_UPLOAD_BYTES=26214400

# ------------------------------------------------------------- encryption
# REQUIRED IN PRODUCTION: base64 url-safe, decodes to exactly 32 bytes.
# Generate with:  python scripts/generate_key.py
EMBEDDING_ENCRYPTION_KEY=

# -------------------------------------------------------------- face model
FACE_MODEL_NAME=buffalo_l
INSIGHTFACE_ROOT=~/.insightface
# docker compose mounts the `insightface_models` volume at /models:
# INSIGHTFACE_ROOT=/models
CUDA_DEVICE_INDEX=0
FORCE_CPU=false
DET_SIZES=640x640
DET_THRESH=0.5
MAX_FACES_PER_FRAME=20
MAX_EMBEDDING_BATCH=64
ENABLE_BATCHED_DETECTION=true

# ---------------------------------------------------------- recognition
RECOGNITION_THRESHOLD=0.40
RECOGNITION_MARGIN=0.10
DUPLICATE_IDENTITY_SIM=0.90
DEDUP_WINDOW_SECONDS=120
DEDUP_LOG_ALL=false
LOG_UNKNOWN_FACES=true

# ------------------------------------------------------------- alerting
# Accepted match below this cosine raises a `low_confidence` alert.
ALERT_LOW_CONFIDENCE=0.55
# Same (student, camera) low-confidence alerts suppressed within this window.
ALERT_DEDUP_WINDOW_S=300
# Period-deviation grace windows (minutes): absent / late / early exit.
ABSENT_GRACE_MINUTES=15
LATE_GRACE_MINUTES=5
EARLY_EXIT_MINUTES=10

# ------------------------------------------------------------- enrollment
MIN_REFERENCE_PHOTOS=3
MAX_REFERENCE_PHOTOS=5
FACE_QUALITY_ENABLED=true
REGISTRATION_NO_PATTERN=^[A-Za-z0-9_-]{6,12}$
CONFIRMATION_FRAMES=3
CONFIRMATION_WINDOW_S=10.0

# ------------------------------------------- attendance policy (per period)
# Default PRESENT threshold: minutes of confirmed presence required inside
# the scheduled window (policy example: 30 of a 60-minute lecture).  A
# period can override both via its own required_minutes / required_ratio.
ATTENDANCE_DEFAULT_REQUIRED_MINUTES=30
# 0 = minutes-only mode; otherwise the applied threshold is
# max(minutes, ratio x scheduled length).
ATTENDANCE_DEFAULT_REQUIRED_RATIO=0.0
# Manual override reasons are rejected below this length (trimmed).
OVERRIDE_REASON_MIN_LENGTH=5

# ------------------------------------------------------ presence tracking
# Persistent OUTSIDE/ENTRY_PENDING/INSIDE/EXIT_PENDING/NEEDS_REVIEW state
# machine on top of the session layer.  Observations required to cross a
# pending transition (1 = the K-of-N confirmed sighting completes it).
PRESENCE_TRACKING_ENABLED=true
PRESENCE_TRANSITION_OBSERVATIONS=1
PRESENCE_REVIEW_DEDUP_S=300

# --------------------------------------------------- camera management
# Connection test (POST /cameras/test-connection) probe timeout.
CAMERA_CONNECT_TIMEOUT_S=8
# Snapshot cache pacing + MJPEG preview FPS (admin preview endpoints).
CAMERA_SNAPSHOT_INTERVAL_S=1.5
CAMERA_STREAM_FPS=6

# ------------------------------------------------------- shared inference
# redis = shared GPU service (production), inprocess = model inside the
# Celery worker (debugging / single-GPU boxes).
INFERENCE_MODE=redis
INFERENCE_QUEUE_KEY=infer:requests
INFERENCE_RESPONSE_TTL_S=30
INFERENCE_REQUEST_TIMEOUT_S=15
MAX_BATCH_FRAMES=32
INFERENCE_BATCH_WAIT_MS=25

# --------------------------------------------------------------- pipeline
DEFAULT_SAMPLING_RATE=5
FRAME_QUEUE_SIZE=8
BATCH_SIZE=8
BATCH_FLUSH_MS=120
JPEG_QUALITY=85
RTSP_TRANSPORT=tcp
RTSP_OPEN_TIMEOUT_MS=10000
RTSP_READ_TIMEOUT_MS=10000
RECONNECT_INITIAL_DELAY_S=2
RECONNECT_MAX_DELAY_S=30
CAMERA_SLOTS=8
HEARTBEAT_TTL_S=30
# Safety net for camera runtime state keys (deleted on clean stop anyway).
CAMERA_STATE_TTL_S=86400

# --------------------------------------------- docker compose interpolation
# Referenced from docker-compose.yml with ${VAR:-default} - not read by the
# application itself.
POSTGRES_PASSWORD=attendance
API_PORT=8000
API_WORKERS=1
ORT_GPU_VERSION=1.26.0
